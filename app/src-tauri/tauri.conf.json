{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kem Cho",
  "version": "0.1.0",
  "identifier": "app.kemcho.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kem Cho",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520
      },
      {
        "label": "hud",
        "title": "Kem Cho HUD",
        "width": 220,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local voice dictation",
    "longDescription": "Hold a shortcut, speak, and Kem Cho types what you said. Speech is transcribed on your computer with Whisper.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1", "libxdo3"] }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
